{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "software-demo-video.edit-spec.schema.json",
  "title": "Software Demo Video Edit Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "output", "source_provenance", "scenes"],
  "properties": {
    "version": {"const": "software-demo-video.edit-spec/v1"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "audio_sample_rate", "filename"],
      "properties": {
        "width": {"type": "integer", "minimum": 640, "maximum": 7680},
        "height": {"type": "integer", "minimum": 360, "maximum": 4320},
        "fps": {"type": "integer", "enum": [24, 25, 30, 50, 60]},
        "audio_sample_rate": {"type": "integer", "enum": [32000, 44100, 48000]},
        "filename": {"type": "string", "pattern": "^[^/\\\\]+\\.mp4$"}
      }
    },
    "source_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "level", "checked_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
          "label": {"type": "string", "minLength": 1},
          "level": {"type": "string", "enum": ["L1", "L2", "L3", "L4", "local-user-source"]},
          "checked_at": {"type": "string", "minLength": 10}
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "narration", "fact_refs", "visuals", "captions", "overlay", "base_scale", "transform_origin", "masks"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "narration": {"type": "string", "minLength": 1},
          "fact_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "visuals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "start", "duration"],
              "properties": {
                "source": {"type": "string", "minLength": 1},
                "start": {"type": "number", "minimum": 0},
                "duration": {"type": "number", "exclusiveMinimum": 0},
                "playback_rate": {"type": "number", "minimum": 0.25, "maximum": 4}
              }
            }
          },
          "captions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end", "text"],
              "properties": {
                "start": {"type": "number", "minimum": 0},
                "end": {"type": "number", "exclusiveMinimum": 0},
                "text": {"type": "string", "minLength": 1}
              }
            }
          },
          "overlay": {"type": "string", "enum": ["none", "search", "success"]},
          "base_scale": {"type": "number", "minimum": 1, "maximum": 2},
          "transform_origin": {"type": "string", "minLength": 3},
          "camera": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["t", "scale", "x", "y"],
              "properties": {
                "t": {"type": "number", "minimum": 0},
                "scale": {"type": "number", "minimum": 1, "maximum": 2},
                "x": {"type": "number", "minimum": 0, "maximum": 1},
                "y": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          },
          "clicks": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["t", "x", "y"],
              "properties": {
                "t": {"type": "number", "minimum": 0},
                "x": {"type": "number", "minimum": 0, "maximum": 1},
                "y": {"type": "number", "minimum": 0, "maximum": 1},
                "label": {"type": "string"}
              }
            }
          },
          "masks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "width", "height", "color"],
              "properties": {
                "x": {"type": "number", "minimum": 0},
                "y": {"type": "number", "minimum": 0},
                "width": {"type": "number", "exclusiveMinimum": 0},
                "height": {"type": "number", "exclusiveMinimum": 0},
                "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
              }
            }
          }
        }
      }
    }
  }
}
